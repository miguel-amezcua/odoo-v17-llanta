for record in records:
    if record.picking_id.picking_type_code == 'outgoing':
        #verificación el tipo de documento
        if not record.picking_id.origin:
            #Si esta definido algun orgen del documento
            product = env['product.product'].sudo().search (
                            [('categ_id', 'ilike', "Consigna")]
                            )
            if record.product_id not in product:
                raise UserError(('Si este movimiento es de Consignas todos los productos deben ser de Consignas.  \n %s. \n No pertenece a los productos de consigna .') % (record.product_id.name))
                
